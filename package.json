{
  "name": "horse-power",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/prepare-public-site.mjs",
    "start": "tsx server/index.ts",
    "dev:admin": "tsx watch server/platformAdminIndex.ts",
    "admin:bootstrap": "tsx scripts/platform-admin-bootstrap.ts",
    "admin:seed:local": "tsx scripts/platform-admin-local-seed.ts seed",
    "admin:totp:local": "tsx scripts/platform-admin-local-seed.ts totp",
    "admin:totp:homologation": "tsx scripts/platform-admin-homologation-totp.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server tests docs README.md",
    "db:local:migrate": "tsx scripts/local-migrate.ts",
    "db:local:seed": "tsx scripts/local-seed.ts",
    "catalog:inspect": "tsx scripts/catalog-inspect.ts",
    "test:postgres": "tsx --test --test-concurrency=1 tests/localPostgres.integration.ts tests/platformAdmin.integration.ts tests/platformWorkshops.integration.ts tests/dataTransfer.postgres.integration.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "express": "^5.1.0",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "^0.468.0",
    "pg": "8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": "24.x"
  }
}
