# Consulta opcional. Credenciais ficam apenas no servidor, separadas por oficina.
# Copie para .env e preencha somente após contratar o provedor.
PLACA_FIPE_TOKENS_JSON={}
# Exemplo de estrutura: {"hp-centro":"TOKEN_DA_OFICINA"}

# Convites de ativação das oficinas (somente servidor; não versionar valores).
# RESEND_API_KEY=re_...
# WORKSHOP_ACTIVATION_FROM=Sistema Oficinas <ativacao@seu-dominio-verificado>

# FipePlaca (provedor com saldo pré-pago). Prioritário quando configurado.
FIPEPLACA_TOKENS_JSON={}
# Exemplo: {"hp-centro":"TOKEN_DA_OFICINA"}

# Apenas no servidor de produção (Supabase transaction pooler, porta 6543).
# DATABASE_URL=postgresql://APP_ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# APP_ORIGIN=https://seu-dominio
# APP_ORIGINS=https://seu-dominio,https://outro-dominio-autorizado
# PUBLIC_ORIGIN=https://seu-dominio
