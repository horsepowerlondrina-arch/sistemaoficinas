# Copy to .env.local, which is ignored by Git. Encode special URL password characters.
# Set both passwords locally. Never copy cloud DATABASE_URL into these settings.
LOCAL_DATABASE_URL=postgresql://hp_local_app:SUBSTITUA@127.0.0.1:5432/horse_power_local
# Administrator is used only by explicit migration/seed commands, never the server:
LOCAL_ADMIN_DATABASE_URL=postgresql://postgres:SUBSTITUA@127.0.0.1:5432/horse_power_local
PORT=3001
