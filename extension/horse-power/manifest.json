{
  "manifest_version": 3,
  "name": "Horse Power · Conector",
  "version": "1.4.1",
  "description": "Envie peças do Sky Peças ao catálogo e aos orçamentos da Horse Power.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://horse-power.vercel.app/*",
    "https://oficinahorsepower.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cliente.skypecas.com.br/*"
      ],
      "js": [
        "transport.js",
        "sky.js",
        "sky-plate.js"
      ],
      "css": [
        "capture.css"
      ],
      "run_at": "document_idle"
    },
{
      "matches": [
        "https://horse-power.vercel.app/*",
        "https://oficinahorsepower.com.br/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
