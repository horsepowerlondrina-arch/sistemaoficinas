{
  "manifest_version": 3,
  "name": "Horse Power · Conector",
  "version": "1.4.2",
  "description": "Envie peças do Sky Peças aos orçamentos da Horse Power.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://sistema-oficinas-homologacao.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cliente.skypecas.com.br/*"
      ],
      "js": [
        "transport.js",
        "sky.js",
        "sky-plate.js"
      ],
      "css": [
        "capture.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sistema-oficinas-homologacao.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
